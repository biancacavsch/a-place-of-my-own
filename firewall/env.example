# ===== EXEMPLO DE .env =====
# Copie este arquivo para .env e preencha com seus IPs reais
# O .env NUNCA vai pro Git (está no .gitignore)

# Rede local (geralmente 192.168.x.0/24)
# Descubra a sua com: ip route | grep default
LAN_NETWORK=192.168.0.0/24

# Rede Tailscale (padrão 100.64.0.0/10)
TAILSCALE_NETWORK=100.64.0.0/10

# IP do gateway Docker (descubra com: docker network inspect bridge)
# É o IP do host visto pelos containers
DOCKER_GATEWAY=172.17.0.1

# IP do container Pi-hole na rede Docker
# Descubra com: docker inspect pihole | grep IPAddress
PIHOLE_DOCKER_IP=172.17.0.4
